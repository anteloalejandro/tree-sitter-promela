{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "promela",
      "camelcase": "Promela",
      "title": "Promela",
      "scope": "source.promela",
      "file-types": [
        "promela"
      ],
      "injection-regex": "^promela$",
      "class-name": "TreeSitterPromela"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for the Promela language, used by the Spin verification tool.",
    "authors": [
      {
        "name": "Alejandro Antelo",
        "email": "alfasant@protonmail.com",
        "url": "https://github.com/anteloalejandro"
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-promela",
      "funding": ""
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": true,
    "swift": false,
    "zig": false
  }
}